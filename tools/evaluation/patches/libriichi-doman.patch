+
+    #[test]
+    fn doman_no_extension_even_below_30000() {
+        for length in [4, 8] {
+            let mut game = Game {
+                length,
+                doman: true,
+                scores: [25000; 4],
+                ..Default::default()
+            };
+            game.kyoku = length - 1;
+            assert!(!game.scheduled_end());
+            game.kyoku = length;
+            assert!(game.scheduled_end());
+            game.doman = false;
+            assert!(!game.scheduled_end());
+            game.scores[0] = 30000;
+            assert!(game.scheduled_end());
+        }
+    }
+
+    #[test]
+    fn doman_dealer_finish_and_initial_seat_ties() {
+        for length in [4, 8] {
+            let mut game = Game {
+                length,
+                doman: true,
+                kyoku: length - 1,
+                scores: [24000, 24000, 23000, 29000],
+                ..Default::default()
+            };
+            assert!(game.renchan_owari());
+            game.doman = false;
+            assert!(!game.renchan_owari());
+            game.doman = true;
+            game.scores = [25000; 4];
+            assert!(!game.renchan_owari());
+            game.kyoku -= 1;
+            game.scores = [24000, 24000, 29000, 23000];
+            assert!(!game.renchan_owari());
+        }
+    }

+#[cfg(test)]
+mod doman_tests {
+    use super::*;
+    use crate::hand::{hand_with_aka, tile37_to_vec};
+
+    // Every tile comes from one physical 136-tile pool.
+    fn fixture(doman: bool, hands: [Option<&str>; 4], draw: Tile) -> BoardState {
+        let mut board = Board {
+            doman_length: if doman { 4 } else { 0 },
+            scores: [25000; 4],
+            kyotaku: 2,
+            ..Default::default()
+        };
+        let mut pool = UNSHUFFLED.to_vec();
+        for (i, hand) in hands.iter().enumerate() {
+            if let Some(hand) = hand {
+                let tiles = tile37_to_vec(&hand_with_aka(hand).unwrap());
+                for tile in &tiles {
+                    let pos = pool.iter().position(|t| t == tile).unwrap();
+                    pool.remove(pos);
+                }
+                board.haipai[i] = tiles.try_into().unwrap();
+            }
+        }
+        let pos = pool.iter().position(|t| *t == draw).unwrap();
+        pool.remove(pos);
+        for (i, hand) in hands.iter().enumerate() {
+            if hand.is_none() {
+                board.haipai[i] = pool.drain(..13).collect::<Vec<_>>().try_into().unwrap();
+            }
+        }
+        board.rinshan = pool.drain(..4).collect();
+        board.dora_indicators = pool.drain(..5).collect();
+        board.ura_indicators = pool.drain(..5).collect();
+        board.yama = pool;
+        board.yama.push(draw);
+        assert_eq!(board.yama.len(), 70);
+        let mut state = board.into_state();
+        state.step(&Default::default()).unwrap();
+        state
+    }
+
+    fn reaction(actor: u8, event: Event) -> [EventExt; 4] {
+        let mut reactions: [EventExt; 4] = Default::default();
+        reactions[actor as usize] = EventExt::no_meta(event);
+        reactions
+    }
+
+    #[test]
+    fn doman_triple_ron_is_abortive_but_double_ron_pays_both() {
+        for winners in [2, 3] {
+            let mut state = fixture(
+                true,
+                [
+                    None,
+                    Some("123456789m123p1z"),
+                    Some("123456789s456p1z"),
+                    Some("111999p111999s1z"),
+                ],
+                t!(E),
+            );
+            state
+                .step(&reaction(
+                    0,
+                    Event::Dahai {
+                        actor: 0,
+                        pai: t!(E),
+                        tsumogiri: true,
+                    },
+                ))
+                .unwrap();
+            let mut reactions: [EventExt; 4] = Default::default();
+            for actor in 1..=winners {
+                reactions[actor] = EventExt::no_meta(Event::Hora {
+                    actor: actor as u8,
+                    target: 0,
+                    deltas: None,
+                    ura_markers: None,
+                });
+            }
+            assert!(matches!(state.poll(reactions).unwrap(), Poll::End));
+            let result = state.end();
+            assert_eq!(result.has_abortive_ryukyoku, winners == 3);
+            assert_eq!(result.has_hora, winners == 2);
+            if winners == 3 {
+                assert_eq!(result.scores, [25000; 4]);
+                assert_eq!(result.kyotaku_left, 2);
+                assert!(result.can_renchan);
+                assert_eq!(
+                    state
+                        .log
+                        .iter()
+                        .filter(|e| matches!(e.event, Event::Hora { .. }))
+                        .count(),
+                    0
+                );
+            } else {
+                assert!(result.scores[1] > 25000 && result.scores[2] > 25000);
+                assert_eq!(result.scores.iter().sum::<i32>(), 102000);
+            }
+        }
+    }

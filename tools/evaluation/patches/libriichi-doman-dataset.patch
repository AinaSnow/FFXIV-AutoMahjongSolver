+#[cfg(test)]
+mod doman_dataset_tests {
+    use super::*;
+    use crate::{t, hand::{hand_with_aka, tile37_to_vec}};
+
+    fn loader(mode: &str) -> GameplayLoader {
+        GameplayLoader::new(4, false, None, None, false, true, false, mode).unwrap()
+    }
+
+    fn opening() -> Event {
+        let mut tehais = [[t!(?); 13]; 4];
+        tehais[0] = tile37_to_vec(&hand_with_aka("111m234p234s2345m").unwrap()).try_into().unwrap();
+        Event::StartKyoku { bakaze: t!(E), dora_marker: t!(C), kyoku: 4, honba: 0,
+            kyotaku: 0, oya: 3, scores: [25000; 4], tehais }
+    }
+
+    #[test]
+    fn dataset_state_uses_arena_length_and_fifth_kan_mask() {
+        for (mode, length) in [("libriichi-hanchan", 0), ("doman-quick", 4), ("doman-full", 8)] {
+            let config = loader(mode);
+            let mut state = config.player_state(0);
+            assert_eq!(state.doman_length, length);
+            state.update(&opening()).unwrap();
+            for tile in [t!(E), t!(S), t!(W), t!(N)] {
+                state.update(&Event::Ankan { actor: 1, consumed: [tile; 4] }).unwrap();
+            }
+            state.update(&Event::Tsumo { actor: 0, pai: t!(1m) }).unwrap();
+            assert_eq!(state.last_cans().can_ankan, length != 0);
+            assert_eq!(state.encode_obs(4, false).1[42], length != 0);
+        }
+        assert!(GameplayLoader::new(4, false, None, None, false, true, false, "unknown").is_err());
+    }
+
+    #[test]
+    fn non_oracle_loader_does_not_expose_other_starting_hands() {
+        let config = loader("doman-quick");
+        let first = opening();
+        let mut second = opening();
+        if let Event::StartKyoku { tehais, .. } = &mut second {
+            tehais[1] = tile37_to_vec(&hand_with_aka("123456789p1234s").unwrap()).try_into().unwrap();
+        }
+        let log = |start| vec![Event::StartGame { names: ["selfplay".into(), "selfplay".into(),
+            "selfplay".into(), "selfplay".into()], seed: None }, start,
+            Event::Tsumo { actor: 0, pai: t!(1m) },
+            Event::Dahai { actor: 0, pai: t!(1m), tsumogiri: true },
+            Event::Ryukyoku { deltas: Some([0; 4]) }, Event::EndKyoku, Event::EndGame];
+        let a = Gameplay::load_events_by_player(&config, &log(first), 0, None).unwrap();
+        let b = Gameplay::load_events_by_player(&config, &log(second), 0, None).unwrap();
+        assert!(!a.obs.is_empty());
+        assert!(a.invisible_obs.is_empty() && b.invisible_obs.is_empty());
+        assert_eq!(a.obs, b.obs);
+        assert_eq!(a.masks, b.masks);
+        assert_eq!(a.actions, b.actions);
+    }
+}
